# === Supabase (OBLIGATOIRE) ===
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=<anon-key>

# Connexion Postgres directe via pooler (migrations / tooling).
# La connection string complète est construite dans scripts/_supabase.mjs ;
# renseigner uniquement le mot de passe de la base (Database password Supabase).
# Sur Vercel : Settings > Environment Variables > SUPABASE_DB_PASSWORD
SUPABASE_DB_PASSWORD=

# =============================================================================
# === IDENTITÉ DE MARQUE ===
# =============================================================================

NEXT_PUBLIC_APP_NAME=Coligo
NEXT_PUBLIC_APP_SHORT_NAME=Coligo

NEXT_PUBLIC_APP_TAGLINE="Commandez à l'avance chez vos commerces de proximité"
NEXT_PUBLIC_APP_DESCRIPTION="Marketplace algérienne de commande à l'avance"

# === Domaines ===
NEXT_PUBLIC_APP_DOMAIN=coligo.app
NEXT_PUBLIC_MERCHANT_DOMAIN=commercant.coligo.app
NEXT_PUBLIC_ADMIN_DOMAIN=admin.coligo.app

# === Localisation ===
NEXT_PUBLIC_DEFAULT_COUNTRY=DZ
NEXT_PUBLIC_DEFAULT_CURRENCY=DA
NEXT_PUBLIC_PHONE_PREFIX=+213

# === Contact ===
NEXT_PUBLIC_SUPPORT_EMAIL=support@coligo.app
NEXT_PUBLIC_SALES_EMAIL=hello@coligo.app

# === Live chat support (Tawk.to — gratuit) ===
# Créer un compte sur tawk.to → Administration → Channels → Chat Widget :
# copier le Property ID et le Widget ID. Le chat n'apparaît (espaces client +
# livreur, via « Aide & support ») que si NEXT_PUBLIC_TAWK_PROPERTY_ID est défini.
# Sans config → repli sur NEXT_PUBLIC_SUPPORT_EMAIL (mailto).
NEXT_PUBLIC_TAWK_PROPERTY_ID=
NEXT_PUBLIC_TAWK_WIDGET_ID=default

# === Google Analytics 4 (GA4) — OPTIONNEL ===
# Mesure d'audience web + APK (l'APK charge l'app web dans son WebView → couvert
# par la même clé). Créer une propriété GA4 → flux de données « Web » → copier
# l'ID de mesure (format G-XXXXXXXXXX). Public (préfixe NEXT_PUBLIC_), pas secret.
# Sans valeur → AUCUN script GA chargé (no-op total). Le trafic est segmenté
# web / android / ios via la user-property `platform`.
NEXT_PUBLIC_GA_ID=

# === Assistant IA (Anthropic Claude) — OPTIONNEL, usage futur ===
# PAS requis pour l'assistant Drive « Dis où tu veux aller » : celui-ci est
# 100 % déterministe (parseur local + gazetteer), gratuit, sans clé.
# Cette clé est réservée à une future fonction IA (« panier courses » multi-
# produits en langage naturel). ⚠️ SECRET si renseignée (jamais NEXT_PUBLIC_).
ANTHROPIC_API_KEY=

# === Google Places (recherche de lieux — DERNIER RECOURS, payant) ===
# Utilisée UNIQUEMENT en fallback de geocodeSearch quand les sources gratuites
# (gazetteer + commerces OSM + Photon + Nominatim) ne trouvent rien de fiable.
# Verrous coût : cache 30 j + plafonds jour (mig 0178). Sans clé → fallback
# désactivé (le reste marche). Activer « Places API (New) » sur Google Cloud,
# facturation ON, clé restreinte à cette API. ⚠️ SECRET, jamais NEXT_PUBLIC_.
GOOGLE_MAPS_API_KEY=

# === Couleurs de marque ===
NEXT_PUBLIC_BRAND_PRIMARY=#0d9488
NEXT_PUBLIC_BRAND_ACCENT=#d97706

# =============================================================================
# === FCM — Push notifications (APK Capacitor) ===
# =============================================================================
# Clé de COMPTE DE SERVICE Firebase, décomposée. Copier depuis le JSON
# téléchargé sur la console Firebase (Project Settings > Service accounts).
# ⚠️ SECRET — uniquement dans .env.local / variables Vercel (Production +
# Preview, PAS Development pour éviter les fuites en logs). Jamais committé.
# La PRIVATE_KEY peut contenir des \n littéraux (échappés) OU réels — le
# helper lib/fcm/send.ts normalise les deux.
FCM_PROJECT_ID=
FCM_CLIENT_EMAIL=
FCM_PRIVATE_KEY=

# =============================================================================
# === Firebase Web — Push notifications PWA / NAVIGATEUR (tous rôles) ===
# =============================================================================
# Config PUBLIQUE de l'app Web Firebase (Project Settings > General > Tes apps >
# app Web). Non secrète (exposée au client, préfixe NEXT_PUBLIC_), mais REQUISE
# pour activer le push web/PWA. Sans elles, le push web est un no-op (l'APK
# natif continue de fonctionner via les FCM_* ci-dessus).
# La VAPID key se trouve dans Project Settings > Cloud Messaging > Web Push
# certificates (« Key pair »).
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
NEXT_PUBLIC_FIREBASE_VAPID_KEY=
