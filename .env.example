# === Supabase (OBLIGATOIRE) ===
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=<anon-key>

# Connexion Postgres directe via pooler (migrations / tooling).
# La connection string complète est construite dans lib/config/database.ts ;
# renseigner uniquement le mot de passe de la base (Database password Supabase).
# Sur Vercel : Settings > Environment Variables > SUPABASE_DB_PASSWORD
SUPABASE_DB_PASSWORD=

# =============================================================================
# === IDENTITÉ DE MARQUE ===
# =============================================================================

NEXT_PUBLIC_APP_NAME=Coligo
NEXT_PUBLIC_APP_SHORT_NAME=Coligo

NEXT_PUBLIC_APP_TAGLINE="Commandez à l'avance chez vos commerces de proximité"
NEXT_PUBLIC_APP_DESCRIPTION="Marketplace algérienne de commande à l'avance"

# === Domaines ===
NEXT_PUBLIC_APP_DOMAIN=coligo.app
NEXT_PUBLIC_MERCHANT_DOMAIN=commercant.coligo.app
NEXT_PUBLIC_ADMIN_DOMAIN=admin.coligo.app

# === Localisation ===
NEXT_PUBLIC_DEFAULT_COUNTRY=DZ
NEXT_PUBLIC_DEFAULT_CURRENCY=DA
NEXT_PUBLIC_PHONE_PREFIX=+213

# === Contact ===
NEXT_PUBLIC_SUPPORT_EMAIL=support@coligo.app
NEXT_PUBLIC_SALES_EMAIL=hello@coligo.app

# === Couleurs de marque ===
NEXT_PUBLIC_BRAND_PRIMARY=#0d9488
NEXT_PUBLIC_BRAND_ACCENT=#d97706
