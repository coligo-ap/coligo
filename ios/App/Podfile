# CocoaPods sert UNIQUEMENT à Firebase Messaging (pont FCM natif iOS).
#
# Les plugins Capacitor (App, Geolocation, PushNotifications, background-
# geolocation…) sont résolus via Swift Package Manager (ios/App/CapApp-SPM,
# régénéré par `cap sync ios`) — PAS via CocoaPods. Un target Xcode peut
# combiner SPM + CocoaPods sans conflit : c'est le cas ici.
#
# `pod install` (exécuté en local ou par Codemagic) génère ios/App/App.xcworkspace
# — c'est ce fichier qu'il faut ouvrir/builder ensuite, jamais le .xcodeproj seul.

platform :ios, '15.0'
# Recommandation officielle Firebase pour l'intégration CocoaPods (SDK Swift).
use_frameworks! :linkage => :static

target 'App' do
  pod 'FirebaseCore'
  pod 'FirebaseMessaging'
end
